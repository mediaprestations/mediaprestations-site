# Média Prestations — règles pour l'hébergement OVH (Apache)
Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On

# 1. Tout en HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. www.mediaprestations.fr -> mediaprestations.fr
RewriteCond %{HTTP_HOST} ^www\.mediaprestations\.fr$ [NC]
RewriteRule ^ https://mediaprestations.fr%{REQUEST_URI} [L,R=301]

# 3. Anciennes adresses WordPress -> nouvelles pages
RewriteRule ^qui-sommes-nous(/.*)?$ / [L,R=301]
RewriteRule ^(prestations|solutions|Solutions|tarifs)/?$ /#savoir-faire [L,R=301,NE]
RewriteRule ^contacts?/?$ /#contact [L,R=301,NE]
RewriteRule ^mise-en-page(/.*)?$ /realisations/ [L,R=301]
RewriteRule ^conditions-generales/?$ /mentions-legales/ [L,R=301]
RewriteRule ^wp-(admin|login\.php|content|includes)(/.*)?$ / [L,R=301]

# Cache navigateur (images et fichiers versionnés)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
